<section class="section" data-section-id="{{ section.id }}" data-section-type="offers">
  <div class="container">

    <style>
      #shopify-section-{{ section.id }} .offer-item__image-link,
      #shopify-section-{{ section.id }} .offer-item__title-link {
        color: inherit;
        text-decoration: none;
      }

      #shopify-section-{{ section.id }} .offer-item__title-link:hover {
        text-decoration: underline;
      }

      #shopify-section-{{ section.id }} .offer-item__image-link {
        display: block;
      }

      #shopify-section-{{ section.id }} .offer-item__image-link img,
      #shopify-section-{{ section.id }} .offer-item__image-link svg {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.35s ease;
      }

      #shopify-section-{{ section.id }} .offer-item__image-wrapper {
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .offer-item__image-link:hover img,
      #shopify-section-{{ section.id }} .offer-item__image-link:hover svg,
      #shopify-section-{{ section.id }} .offer-item__image-link:focus-visible img,
      #shopify-section-{{ section.id }} .offer-item__image-link:focus-visible svg {
        transform: scale(1.04);
      }

      #shopify-section-{{ section.id }} .offer-item__image-link:focus-visible,
      #shopify-section-{{ section.id }} .offer-item__title-link:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 3px;
      }
    </style>

    {%- capture block_list -%}
      <div class="block-list">
        {%- for block in section.blocks -%}
          <div class="block-list__item 1/{{ section.settings.items_per_row }}--lap-and-up" {{ block.shopify_attributes }}>
            <div class="offer-item {% if section.settings.items_per_row < 4 %}offer-item--inline{% endif %}">

              {%- if block.settings.image -%}
                <div class="offer-item__image-wrapper">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="offer-item__image-link" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.title | escape | default: 'Offer image link' }}">
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: '250px', widths: '250,500,750' -}}
                    </a>
                  {%- else -%}
                    {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: '250px', widths: '250,500,750' -}}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="offer-item__inner">
                {%- if block.settings.title != blank -%}
                  <p class="offer-item__title heading h4">
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="offer-item__title-link" target="_blank" rel="noopener noreferrer">
                        {{ block.settings.title | escape }}
                      </a>
                    {%- else -%}
                      {{ block.settings.title | escape }}
                    {%- endif -%}
                  </p>
                {%- endif -%}

                {%- if block.settings.content != blank -%}
                  <div class="offer-item__content rte">
                    {{ block.settings.content }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endcapture -%}

    {%- if section.settings.stack_mobile -%}
      {{ block_list }}
    {%- else -%}
      <div class="scroller">
        <div class="scroller__inner">
          {{ block_list }}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Offers",
  "settings": [
    {
      "type": "range",
      "id": "items_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Items per row on desktop",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "Stack on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "250 x 250px .jpg recommended"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Your text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image + Heading link (optional)"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "default": "<p>Write a few words about your offers or your shop.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Text",
      "name": "Offers",
      "settings": {},
      "blocks": [
        {
          "type": "offer"
        },
        {
          "type": "offer"
        }
      ]
    }
  ]
}
{% endschema %}