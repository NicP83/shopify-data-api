    "faq_6eEtKr": {
      "type": "faq",
      "blocks": {
        "separator_WXXKML": {
          "type": "separator",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "question_kNQLVL": {
          "type": "question",
          "settings": {
            "title": "What is the OO scale?",
            "answer": "<p>OO scale is a popular scale for model railways, with a track gauge of 16.5mm and models typically measuring 1:76 of the real-life size.</p>"
          }
        },
        "question_B6EyMM": {
          "type": "question",
          "settings": {
            "title": "What is the OO-9 scale?",
            "answer": "<p>OO-9 combines OO scale trains (1:76) with N gauge track (9mm) to model narrow gauge railways (around 2ft 3in wide). Great for space-saving, detailed layouts in the UK!</p>"
          }
        },
        "question_Ecppar": {
          "type": "question",
          "settings": {
            "title": "What do I need to get started with a model railway?",
            "answer": "<p>To get started, you'll need a starter set that includes a locomotive, carriages, track, and a controller. Hearns Hobbies offers a variety of Bachmann Branchline starter sets to suit different budgets and interests.</p>"
          }
        },
        "question_HcqTqw": {
          "type": "question",
          "settings": {
            "title": "How do I build a model railway layout?",
            "answer": "<p>There are many resources available online and in hobby magazines to help you design and build your model railway layout. The Hearns Hobbies team is also happy to offer advice and guidance.</p>"
          }
        },
        "question_C9ze4m": {
          "type": "question",
          "settings": {
            "title": "Are Bachmann Branchline models suitable for beginners?",
            "answer": "<p>Yes, Bachmann Branchline models are suitable for model railway enthusiasts of all skill levels. Whether you're a beginner or an experienced hobbyist, you'll find our models easy to assemble and operate.</p>"
          }
        },
        "question_PcFw3P": {
          "type": "question",
          "settings": {
            "title": "Can I customise Bachmann Branchline models?",
            "answer": "<p>Yes, Bachmann Branchline models are highly customizable. You can personalise your models with additional detailing, weathering techniques, and aftermarket accessories to create a unique and realistic railway scene.</p>"
          }
        },
        "question_D8wT6e": {
          "type": "question",
          "settings": {
            "title": "Do Bachmann Branchline models come with a warranty?",
            "answer": "<p>Yes, Bachmann Branchline models are covered by a manufacturer's warranty against defects in materials and workmanship. Please refer to the warranty terms and conditions for more information.</p>"
          }
        }
      },
