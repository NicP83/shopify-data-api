    "faq_6LYTze": {
      "type": "faq",
      "blocks": {
        "separator_GbFA3F": {
          "type": "separator",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "question_ePRkWj": {
          "type": "question",
          "settings": {
            "title": "Do I need a primer for the chrome and holographic paints?",
            "answer": "<p>No primer is needed for the chrome or <a href=\"https://www.hearnshobbies.com/products/green-stuff-world-holographic-paint\"><span style=\"text-decoration:underline\">holographic paints</span></a> although a black base will enhance the airbrush chrome and holographic paints.</p>"
          }
        },
        "question_tCfCkD": {
          "type": "question",
          "settings": {
            "title": "What is the best way to apply the liquid pigments?",
            "answer": "<p>Brush them or flick them on with a brush. The finish can be manipulated while still wet. If you’d like to know more about how to apply liquid pigments, you may watch our <a href=\"https://youtube.com/playlist?list=PLPaKXy5RLwB3FnWMY39EgiehL88PokF-g&si=tejDOgLljBk4YbJu\"><span style=\"text-decoration:underline\">Green Stuff World Paints</span></a> videos on YouTube.</p>"
          }
        },
        "question_VRn6jp": {
          "type": "question",
          "settings": {
            "title": "How long does it take to dry?",
            "answer": "<p>Acrylic paints dry very quickly but does depend on the thickness of the coat and environmental conditions.</p>"
          }
        },
        "question_VQ9myy": {
          "type": "question",
          "settings": {
            "title": "What is dipping ink?",
            "answer": "<p>These are a highly pigmented wash that adds depth to the recesses of the surface. Can be dipped or brushed on.</p>"
          }
        },
        "question_hD9Byf": {
          "type": "question",
          "settings": {
            "title": "What is a metal filter?",
            "answer": "<p>Metal filters have a transparent metallic finish that alters the appearance of the base colour. They can add depth and achieve a slight colour shift when viewed from different angles.</p>"
          }
        },
        "question_JRVQHr": {
          "type": "question",
          "settings": {
            "title": "Are Fluoro Paints glow in the dark?",
            "answer": "<p>Fluorescent paints do not glow in the dark but will become luminous when UV or black light is applied.</p>"
          }
        }
      },
