        },
        "offer_NtEbMz": {
          "type": "offer",
          "settings": {
            "title": "",
            "content": "<p>Joysway slot car systems use a USB power system and provide a USB power cable to connect to your own power bank or smart phone USB power adapter.</p>"
          }
        }
