        },
        "offer_NrR4DJ": {
          "type": "offer",
          "settings": {
            "title": "",
            "content": "<p>The range of slot car sets which Joysway produce allow you to choose from basic race tracks though to more complex and exciting tracks where your skills will be tested to the limit.</p>"
