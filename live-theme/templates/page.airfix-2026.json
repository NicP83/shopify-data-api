    "faq_bfX9EQ": {
      "type": "faq",
      "blocks": {
        "separator_DBEfYX": {
          "type": "separator",
          "settings": {
            "title": "Pre-Order FAQ"
          }
        },
        "question_HjPhzt": {
          "type": "question",
          "settings": {
            "title": "How do pre-orders work?",
            "answer": "<p>When you pre-order, you pay upfront to secure your kit. As soon as stock arrives from our supplier, your order is packed and shipped. Pre-order customers are fulfilled first, before general stock goes on sale.</p>"
          }
        },
        "question_UTgYy7": {
          "type": "question",
          "settings": {
            "title": "When will my kit arrive?",
            "answer": "<p>Airfix 2026 releases are staggered across three waves: AU Autumn 2026, AU Winter 2026, and AU Spring 2026. Exact dates depend on the supplier. We'll email you when your order ships.</p>"
          }
        },
        "question_yey6im": {
          "type": "question",
          "settings": {
            "title": "Can I cancel a pre-order?",
            "answer": "<p>Yes. Contact us before the item ships and we'll process a full refund. See our<a href=\"/policies/refund-policy\">Refund Policy</a>for details.</p>"
          }
        },
        "question_J398EK": {
          "type": "question",
          "settings": {
            "title": "Do I need paint and glue?",
            "answer": "<p><strong>Yes. </strong>All Airfix model kits (except Starter Sets) require separate paint and glue — these are not included in the box. We stock a full range of model paints from<a href=\"/collections/paints-and-tools\">Tamiya, Vallejo, Mr. Hobby, and Green Stuff World</a>, plus cement, tools, and brushes. Check individual product pages for recommended supplies, or visit our<a href=\"/collections/model-tools\">Ninesteps tool range</a>for precision modelling tools.</p>"
          }
        },
        "question_fDnxYA": {
          "type": "question",
          "settings": {
            "title": "Do you offer free shipping?",
            "answer": "<p>Free shipping Australia-wide on orders over $125. <a href=\"/pages/shipping-information\">Shipping details</a>.</p>"
          }
        }
      },
