      "settings": {
        "text_width": "wide",
        "title": "Why Pre-Order with Hearns Hobbies?",
        "content": "<ul><li><strong>Australia's oldest hobby shop</strong> — serving modellers since 1947</li><li><strong>Expert advice</strong> — our team builds models. We know these kits.</li><li><strong>Two locations</strong> — <a href=\"/pages/contact-us-here\">Melbourne CBD (295 Flinders St)</a> and Hallam (Factory 5/25 Conquest Way)</li><li><strong>Fast shipping</strong> — order before 11am, ships same day (AU only)</li><li><strong>Free shipping</strong> over $125 Australia-wide</li><li><strong>Full support range</strong> — paints, tools, glue, and <a href=\"/collections/model-tools\">Ninesteps precision tools</a> all in one shop</li></ul><p><strong>Questions?</strong> Call us on <a href=\"tel:0396143603\">(03) 9614 3603</a> (Melbourne CBD) or <a href=\"tel:0397056880\">(03) 9705 6880</a> (Hallam). Email: <a href=\"mailto:info@hearnshobbies.com\">info@hearnshobbies.com</a></p>",
        "button_text": "",
        "button_link": ""
      }
