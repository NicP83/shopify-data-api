        "1658930183f010c50f-1": {
          "type": "question",
          "settings": {
            "title": "What types of model paint exist?",
            "answer": "<p>Acrylics, enamels, and lacquers. Acrylics are probably the best option for beginner models due to the ease of cleaning.</p>"
          }
        },
        "1658930183f010c50f-2": {
          "type": "question",
          "settings": {
            "title": "What’s the best paint for beginners?",
            "answer": "<p>Because of their ease of cleaning, acrylics are probably the best choice for beginner models.</p>"
          }
        },
        "1658930183f010c50f-3": {
          "type": "question",
          "settings": {
            "title": "What tools are needed to build a model kit?",
            "answer": "<p>▪ <a href=\"https://www.hearnshobbies.com/collections/basic-plastic-model-building-tools-and-accessories\" target=\"_blank\" title=\"https://www.hearnshobbies.com/collections/basic-plastic-model-building-tools-and-accessories\">Basic tool</a> needed to make scale model kits.</p><p>▪ <a href=\"https://www.hearnshobbies.com/collections/advanced-plastic-model-building-tools-and-accessories\" target=\"_blank\" title=\"https://www.hearnshobbies.com/collections/advanced-plastic-model-building-tools-and-accessories\">Advanced tool</a> needed to make scale model kits.</p>"
          }
        }
