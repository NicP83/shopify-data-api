        "1658930183f010c50f-1": {
          "type": "question",
          "settings": {
            "title": "What’s the best car for beginners?",
            "answer": "<p>One of the best parts about RC is the incredible variety of vehicles available! Here are the best model kits for you to begin with: </p><p>Tornado: <a href=\"https://www.hearnshobbies.com/collections/tornado-rtr\">Entry Level RC</a></p>"
          }
        },
        "1658930183f010c50f-2": {
          "type": "question",
          "settings": {
            "title": "How to get started in RC Racing?",
            "answer": "<p>Here are <a href=\"https://www.hearnshobbies.com/blogs/news/how-to-get-started-in-rc-racing\" target=\"_blank\" title=\"https://www.hearnshobbies.com/blogs/news/how-to-get-started-in-rc-racing\">six RC racing tips</a> to get you started.</p>"
          }
        },
        "1658930183f010c50f-3": {
          "type": "question",
          "settings": {
            "title": "How to charge RC batteries?",
            "answer": "<p><a href=\"https://youtu.be/ZPDd0d0Kapg\" target=\"_blank\" title=\"https://youtu.be/ZPDd0d0Kapg\">Watch</a> and <a href=\"https://www.hearnshobbies.com/blogs/news/how-to-charge-rc-car-batteries-nimh-lipo\" target=\"_blank\" title=\"https://www.hearnshobbies.com/blogs/news/how-to-charge-rc-car-batteries-nimh-lipo\">read</a> about the different types of RC car batteries, NiMH and LiPo, and how to charge them.</p>"
          }
